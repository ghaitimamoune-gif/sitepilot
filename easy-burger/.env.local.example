# ------------------------------------------------------------------
# Easy Burger — variables d'environnement
# ------------------------------------------------------------------
# La Phase 0 (design system + coquille PWA) tourne SANS ces variables.
# Elles deviennent nécessaires en Phase 1, quand le menu vient de la base.
#
# Où les trouver : dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service — SERVEUR UNIQUEMENT, jamais exposée au navigateur.
# Utilisée par les jobs (expiration des points, import des tickets caisse).
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Travaux périodiques (app/api/jobs)
# ------------------------------------------------------------------
# Secret partagé avec le planificateur. Un POST /api/jobs avec
# `Authorization: Bearer <valeur>` déclenche : expiration des codes et des
# points, cadeaux d'anniversaire, rapprochement des tickets, alertes
# d'expiration, envoi des messages en file. Tout est idempotent.
CRON_SECRET=

# ------------------------------------------------------------------
# Paiement en ligne — §12, en attente des contrats
# ------------------------------------------------------------------
# Tant que ces variables sont vides, l'application reste en espèces.
PAYZONE_MERCHANT_ID=
PAYZONE_API_KEY=
PAYZONE_WEBHOOK_SECRET=

CMI_CLIENT_ID=
CMI_STORE_KEY=
CMI_GATEWAY_URL=

# ------------------------------------------------------------------
# Passerelle SMS — §13 et §16, en attente du choix de fournisseur
# ------------------------------------------------------------------
# Tant qu'elles sont vides, les messages sont journalisés au lieu d'être
# envoyés : la file se vide, le contenu reste vérifiable.
SMS_ENDPOINT=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER=
