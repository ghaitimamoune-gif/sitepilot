# ------------------------------------------------------------------
# Easy Burger — variables d'environnement
# ------------------------------------------------------------------
# La Phase 0 (design system + coquille PWA) tourne SANS ces variables.
# Elles deviennent nécessaires en Phase 1, quand le menu vient de la base.
#
# Où les trouver : dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service — SERVEUR UNIQUEMENT, jamais exposée au navigateur.
# Utilisée par les jobs (expiration des points, import des tickets caisse).
SUPABASE_SERVICE_ROLE_KEY=
