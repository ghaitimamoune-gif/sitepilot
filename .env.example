# ============================================================
# SitePilot — variables d'environnement
# ============================================================
# En local : copiez ce fichier en `.env.local` puis renseignez les valeurs.
# En production (Netlify) : Site settings → Environment variables.
#
# Ces deux variables sont OBLIGATOIRES. Sans elles, l'application ne peut
# joindre aucune base de données et affiche un écran de configuration.
#
# Valeurs à récupérer dans Supabase → Settings → API.
#
# Important : les variables NEXT_PUBLIC_* sont intégrées au bundle au moment
# du build. Après les avoir ajoutées ou modifiées sur Netlify, relancez un
# déploiement — un simple redémarrage ne les prendra pas en compte.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
