# --- Base de données PostgreSQL (Supabase, Neon ou serveur local) ---
DATABASE_URL=postgres://eb:eb@localhost:5432/easyburger

# --- Secret serveur (signatures des cookies, empreintes des jetons). 32 caractères aléatoires minimum.
# Générer avec : openssl rand -hex 32
APP_SECRET=changez-moi-avant-la-mise-en-production

# --- Photos ---
# Sur un serveur avec disque persistant : dossier local.
DATA_DIR=./data
# Sur Vercel (disque non persistant) : stockage Supabase, bucket PRIVÉ. La clé de service reste côté serveur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos

# --- Planificateur externe (Vercel Cron ou cron système) sur /api/cron/tick ---
CRON_SECRET=

# --- Fuseau horaire de l'exploitation ---
TZ=Africa/Casablanca
