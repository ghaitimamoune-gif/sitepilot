# Base de données PostgreSQL (Supabase, Neon ou serveur local)
DATABASE_URL=postgres://eb:eb@localhost:5432/easyburger

# Secret serveur (cookies de session et d'enrôlement). 32 caractères aléatoires minimum.
# Générer avec : openssl rand -hex 32
APP_SECRET=changez-moi-avant-la-mise-en-production

# Dossier des fichiers (photos). Sur Vercel, utiliser un stockage objet (voir DEPLOIEMENT.md).
DATA_DIR=./data

# Secret appelé par le planificateur externe sur /api/cron/tick (facultatif)
CRON_SECRET=

# Fuseau horaire de l'exploitation
TZ=Africa/Casablanca
